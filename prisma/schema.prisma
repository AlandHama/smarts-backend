  status               SupportAgentStatus @default(OFFLINE)
  maxConcurrentTickets Int                @default(10)
  lastSeenAt           DateTime?
  grantedAt            DateTime           @default(now())
  grantedById          String?            @db.Uuid
  revokedAt            DateTime?
  revokedById          String?            @db.Uuid
