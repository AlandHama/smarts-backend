model User {
  id                         String                  @id @default(uuid()) @db.Uuid
  username                   String                  @unique @db.VarChar(50)
  passwordHash               String                  @db.VarChar(255)
  firstName                  String?                 @db.VarChar(100)
  lastName                   String?                 @db.VarChar(100)
  email                      String?                 @unique @db.VarChar(255)
  status                     UserStatus              @default(ACTIVE)
  accountOrigin              AccountOrigin           @default(WHITELABEL)
  isSystemAdmin              Boolean                 @default(false)
  lastOnline                 DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  sessions                   Session[]
  externalIdentities         ExternalIdentity[]
  profile                    PlayerProfile?
  stats                      PlayerStats?
  wallet                     Wallet?
  progressions               PlayerProgression[]
  idempotencyKeys            IdempotencyKey[]
  progressionEvents          ProgressionEvent[]
  rewardGrants               RewardGrant[]
  leaderboardEntries         LeaderboardEntry[]
  leaderboardScoreEvents     LeaderboardScoreEvent[] @relation("LeaderboardScoreEventPlayer")
  createdMatches             Match[]                 @relation("MatchCreatedBy")
  matchParticipants          MatchParticipant[]
  gameStats                  PlayerGameStats[]
  cognitiveStats             PlayerCognitiveStats?
  inventoryItems             InventoryItem[]
  purchases                  Purchase[]
  entitlements               Entitlement[]
  storageItems               PlayerStorageItem[]
  files                      StoredFile[]
  feedback                   PlayerFeedback[]
  friendRequestsSent         FriendRequest[]         @relation("FriendRequestRequester")
  friendRequestsReceived     FriendRequest[]         @relation("FriendRequestAddressee")
  friendships                Friendship[]            @relation("FriendshipUser")
  friendsOf                  Friendship[]            @relation("FriendshipFriend")
  blocksCreated              FriendBlock[]           @relation("FriendBlocker")
  blockedBy                  FriendBlock[]           @relation("FriendBlocked")
  presence                   Presence?
  matchmakingTickets         MatchmakingTicket[]
  matchmakingInvitesSent     MatchmakingInvite[]     @relation("MatchmakingInviteInviter")
  matchmakingInvitesReceived MatchmakingInvite[]     @relation("MatchmakingInviteInvitee")
  adRewardClaims             AdRewardClaim[]
  notifications              Notification[]
  pushDevices                PushDevice[]
  notificationBroadcasts     NotificationBroadcast[] @relation("NotificationBroadcastCreator")
  adminAuditEvents           AdminAuditEvent[]
  playerAuditEvents          PlayerAuditEvent[]
  paidRewardRequests         PaidRewardRequest[]
  paidRewardDecisions        PaidRewardRequest[]     @relation("PaidRewardRequestDecider")
  gldControlUpdates          GldAdminControl[]       @relation("GldControlUpdater")
  gldManualBackings          GldManualBacking[]      @relation("GldManualBackingCreator")
  assignedRedeemCodes        AssetRedeemCode[]       @relation("RedeemCodeAssignedUser")
  gldBurnEvents              GldBurnEvent[]
  gldDailyAdStates           GldPlayerDailyAdState[]
  sentGifts                  PlayerGift[]            @relation("SentGifts")
  receivedGifts              PlayerGift[]            @relation("ReceivedGifts")
  referralCode               ReferralCode?
  referralsAsReferrer        Referral[]              @relation("ReferralReferrer")
  referralAsReferred         Referral?               @relation("ReferralReferred")
  referralRewardsAsReferrer  ReferralReward[]        @relation("ReferralRewardReferrer")
  referralRewardsAsReferred  ReferralReward[]        @relation("ReferralRewardReferred")
  referralConfigUpdates      ReferralConfig[]        @relation("ReferralConfigUpdater")
  referralPolicyOverride     ReferralPlayerOverride?
  rankingWins                RankingMatch[]          @relation("RankingMatchWinner")
  missionRows                PlayerMission[]
  achievementRows            PlayerAchievement[]
  engagementEvents           EngagementEvent[]
  dailyStreak                PlayerDailyStreak?
  streakActivities           StreakActivity[]
  fraudProfile               FraudProfile?
  fraudSignals               FraudSignal[]
  fraudCases                 FraudCase[]             @relation("FraudCasesForUser")
  fraudCasesAssigned         FraudCase[]             @relation("FraudCaseAssignee")
  fraudProfilesReviewed      FraudProfile[]          @relation("FraudProfileReviewer")
  fraudActions               FraudAction[]           @relation("FraudActionActor")
  fraudActionsForUser        FraudAction[]           @relation("FraudActionsForUser")
  chatParticipants           ChatParticipant[]
  chatMessagesSent           ChatMessage[]           @relation("ChatMessageSender")
  createdChatConversations   ChatConversation[]      @relation("ChatConversationCreator")
  chatRestrictions           ChatRestriction[]
  chatReportsFiled           ChatReport[]            @relation("ChatReportReporter")
  supportAgentProfile        SupportAgent?
  supportTickets              SupportTicket[]         @relation("SupportTicketPlayer")
  supportMessages             SupportTicketMessage[]  @relation("SupportMessageSender")
  supportTicketEvents         SupportTicketEvent[]    @relation("SupportTicketEventActor")
  supportAuditEvents          SupportAuditEvent[]     @relation("SupportAuditActor")
  supportTicketReads          SupportTicketRead[]
  supportConfigurationUpdates  SupportConfiguration[]  @relation("SupportConfigurationUpdater")
  supportAgentsGranted        SupportAgent[]          @relation("SupportAgentGrantedBy")
  supportAgentsRevoked        SupportAgent[]          @relation("SupportAgentRevokedBy")
}

/// A provider identity is linked to a local account after the provider token
/// has been verified by the backend. The provider subject, not the email, is
/// the durable Google identity key.
model ExternalIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(40)
  providerSubject String   @db.VarChar(255)
  email           String?  @db.VarChar(255)
  displayName     String?  @db.VarChar(120)
  avatarUrl       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
}

/// Public Google client IDs are safe to deliver to the mobile app. No client
/// secret or Play Store service-account credential belongs in this record.
model GoogleAuthConfig {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique @default("default") @db.VarChar(40)
  enabled         Boolean  @default(false)
  webClientId     String?  @db.VarChar(255)
  androidClientId String?  @db.VarChar(255)
  iosClientId     String?  @db.VarChar(255)
  desktopClientId String?  @db.VarChar(255)
  packageName     String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  tokenId             String        @unique @db.Uuid
  sessionStatus       SessionStatus @default(ACTIVE)
  isMobileSession     Boolean       @default(true)
  clientVersion       String?       @db.VarChar(32)
  appBuildNumber      String?       @db.VarChar(32)
  platform            String?       @db.VarChar(32)
  osName              String?       @db.VarChar(40)
  osVersion           String?       @db.VarChar(80)
  deviceType          String?       @db.VarChar(40)
  deviceModel         String?       @db.VarChar(120)
  deviceManufacturer  String?       @db.VarChar(80)
  deviceLocale        String?       @db.VarChar(40)
  deviceTimezone      String?       @db.VarChar(80)
  isPhysicalDevice    Boolean?
  deviceInfo          String?       @db.VarChar(500)
  ipAddress           String?       @db.VarChar(100)
  deviceName          String?       @db.VarChar(100)
  location            String?       @db.VarChar(100)
  loginTimestamp      DateTime      @default(now())
  lastActiveTimestamp DateTime      @default(now())
  expiresAt           DateTime
  refreshTokenHash    String        @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenId])
  @@index([userId, sessionStatus])
  @@index([expiresAt])
}

/// Singleton public app policy controlled by system administrators.
model AppConfiguration {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique @default("default") @db.VarChar(40)
  productionVersion  String   @default("1.0.0") @db.VarChar(32)
  developmentVersion String   @default("1.0.0") @db.VarChar(32)
  playStoreUrl       String   @default("https://play.google.com/store/apps/details?id=com.pheonix.gaemverse") @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Server-owned daily activity streak policy. The singleton is editable from
/// System Admin; milestone rows make each bonus auditable and independently
/// editable without shipping a new mobile build.
model StreakConfiguration {
  id                 String            @id @default(uuid()) @db.Uuid
  key                String            @unique @default("default") @db.VarChar(40)
  enabled            Boolean           @default(true)
  qualifyingActivity String            @default("MATCH_COMPLETED") @db.VarChar(40)
  timezone           String            @default("UTC") @db.VarChar(40)
  maxBonusPercent    Decimal           @default(30) @db.Decimal(20, 6)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  milestones         StreakMilestone[]
}

model StreakMilestone {
  id              String              @id @default(uuid()) @db.Uuid
  configurationId String              @db.Uuid
  day             Int
  bonusPercent    Decimal             @db.Decimal(20, 6)
  title           String?             @db.VarChar(120)
  description     String?             @db.VarChar(300)
  enabled         Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  configuration   StreakConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, day])
  @@index([configurationId, enabled, day])
}

model PlayerDailyStreak {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique @db.Uuid
  currentDays       Int              @default(0)
  longestDays       Int              @default(0)
  lastQualifiedDate DateTime?        @db.Date
  lastQualifiedAt   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities        StreakActivity[]

  @@index([lastQualifiedDate])
}

/// One qualifying activity per player/day is retained as the idempotency and
/// audit record. A match may be settled more than once by retrying clients,
/// but it can never advance a streak twice.
model StreakActivity {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  streakId     String            @db.Uuid
  activityType String            @db.VarChar(40)
  activityDate DateTime          @db.Date
  sourceId     String            @db.VarChar(255)
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  streak       PlayerDailyStreak @relation(fields: [streakId], references: [id], onDelete: Cascade)

  @@unique([userId, activityType, activityDate])
  @@unique([userId, activityType, sourceId])
  @@index([userId, activityDate])
}

model Presence {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  lastHeartbeatAt DateTime
  lastSeenAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastHeartbeatAt])
  @@index([lastSeenAt])
}

model FriendRequest {
  id          String              @id @default(uuid()) @db.Uuid
  requesterId String              @db.Uuid
  addresseeId String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  respondedAt DateTime?
  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User                @relation("FriendRequestAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

model Friendship {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  friendId   String   @db.Uuid
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend     User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@index([userId, acceptedAt])
}

model FriendBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("FriendBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("FriendBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ChatConfiguration {
  id                       String    @id @default(uuid()) @db.Uuid
  key                      String    @unique @default("default") @db.VarChar(40)
  enabled                  Boolean   @default(true)
  retentionDays            Int       @default(7)
  maxMessageLength         Int       @default(1000)
  maxMessagesPerMinute     Int       @default(20)
  maxMessagesPerDay        Int       @default(500)
  typingEnabled            Boolean   @default(true)
  readReceiptsEnabled      Boolean   @default(true)
  pushNotificationsEnabled Boolean   @default(true)
  includeMessagePreview    Boolean   @default(false)
  friendChatOnly           Boolean   @default(true)
  allowLinks               Boolean   @default(false)
  maintenanceMessage       String?   @db.VarChar(300)
  lastCleanupAt            DateTime?
  lastCleanupDeleted       Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ChatConversation {
  id            String               @id @default(uuid()) @db.Uuid
  pairKey       String?              @unique @db.VarChar(80)
  type          ChatConversationType @default(DIRECT_FRIEND)
  name          String?              @db.VarChar(80)
  imageUrl      String?              @db.Text
  createdById   String?              @db.Uuid
  lastMessageAt DateTime?
  lastMessageId String?              @db.Uuid
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdBy     User?                @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants  ChatParticipant[]
  messages      ChatMessage[]
  reports       ChatReport[]

  @@index([lastMessageAt])
}

model ChatParticipant {
  id               String           @id @default(uuid()) @db.Uuid
  conversationId   String           @db.Uuid
  userId           String           @db.Uuid
  role             ChatParticipantRole @default(MEMBER)
  wallpaperKey     String?          @db.VarChar(80)
  lastReadSequence Int              @default(0)
  mutedUntil       DateTime?
  joinedAt         DateTime         @default(now())
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model ChatMessage {
  id              String           @id @default(uuid()) @db.Uuid
  conversationId  String           @db.Uuid
  senderId        String           @db.Uuid
  sequence        Int
  clientMessageId String           @db.VarChar(120)
  body            String           @db.Text
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedBy       String?          @db.Uuid
  moderationState ChatMessageState @default(VISIBLE)
  metadata        Json?
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reports         ChatReport[]

  @@unique([conversationId, sequence])
  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@index([senderId, createdAt])
  @@index([moderationState, createdAt])
}

/// A server-owned restriction. Rows are retained as moderation history; an
/// active row has no revokedAt and either no expiry or an expiry in the future.
model ChatRestriction {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  reason          String    @db.VarChar(500)
  restrictedUntil DateTime?
  createdBy       String    @db.Uuid
  revokedAt       DateTime?
  revokedBy       String?   @db.Uuid
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, restrictedUntil])
  @@index([createdAt])
}

/// Player-submitted reports are immutable submissions. Staff resolution is
/// tracked on the same row without deleting the original report.
model ChatReport {
  id             String             @id @default(uuid()) @db.Uuid
  dedupeKey      String             @unique @db.VarChar(255)
  reporterId     String             @db.Uuid
  conversationId String             @db.Uuid
  messageId      String?            @db.Uuid
  category       ChatReportCategory
  reason         String?            @db.VarChar(500)
  status         ChatReportStatus   @default(OPEN)
  reviewedBy     String?            @db.Uuid
  reviewedAt     DateTime?
  resolutionNote String?            @db.VarChar(500)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reporter       User               @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ChatMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId, createdAt])
}

/// Explicitly preserved moderation evidence. It is a snapshot so retention
/// cleanup can remove the live message without destroying a case record.
model ChatEvidence {
  id               String    @id @default(uuid()) @db.Uuid
  messageId        String    @db.Uuid
  conversationId   String    @db.Uuid
  senderId         String    @db.Uuid
  body             String    @db.Text
  messageCreatedAt DateTime
  caseReference    String?   @db.VarChar(120)
  reason           String    @db.VarChar(500)
  preservedBy      String    @db.Uuid
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@index([expiresAt])
}

/// One server-generated, shareable invitation code per player.
model ReferralCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @unique @db.Uuid
  code        String     @unique @db.VarChar(32)
  inviteCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

/// Global referral policy. Referral GLD is a split of an eligible referred ad
/// reward, never an additional emission outside the GLD ad budget.
model ReferralConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  singletonKey         String   @unique @default("default") @db.VarChar(32)
  enabled              Boolean  @default(true)
  maxInvitesPerUser    Int      @default(25)
  rewardBps            Int      @default(1000)
  maxRewardPerReferral BigInt   @default(1000)
  minQualifyingAds     Int      @default(1)
  updatedById          String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedBy            User?    @relation("ReferralConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Optional per-referrer referral policy. Null fields inherit the global policy.
model ReferralPlayerOverride {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  enabled              Boolean?
  maxInvitesPerUser    Int?
  rewardBps            Int?
  maxRewardPerReferral BigInt?
  minQualifyingAds     Int?
  updatedById          String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// A player can be attributed to at most one referrer for the lifetime of the
/// account. Attribution is intentionally independent from Friendship.
model Referral {
  id               String           @id @default(uuid()) @db.Uuid
  referralCodeId   String           @db.Uuid
  referrerId       String           @db.Uuid
  referredId       String           @unique @db.Uuid
  status           ReferralStatus   @default(ACTIVE)
  referredAdCount  Int              @default(0)
  totalRewardedGld BigInt           @default(0)
  rewardCount      Int              @default(0)
  invitedAt        DateTime         @default(now())
  qualifiedAt      DateTime?
  cappedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  referralCode     ReferralCode     @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referrer         User             @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred         User             @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  rewards          ReferralReward[]

  @@unique([referrerId, referredId])
  @@index([referrerId, status, createdAt])
  @@index([status, createdAt])
}

/// Each referral reward is linked to exactly one verified ad claim for
/// idempotency and reconciliation.
model ReferralReward {
  id              String               @id @default(uuid()) @db.Uuid
  referralId      String               @db.Uuid
  adRewardClaimId String               @unique @db.Uuid
  referrerId      String               @db.Uuid
  referredId      String               @db.Uuid
  grossAdReward   BigInt
  rewardAmount    BigInt
  status          ReferralRewardStatus @default(GRANTED)
  createdAt       DateTime             @default(now())
  referral        Referral             @relation(fields: [referralId], references: [id], onDelete: Cascade)
  adRewardClaim   AdRewardClaim        @relation(fields: [adRewardClaimId], references: [id], onDelete: Restrict)
  referrer        User                 @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User                 @relation("ReferralRewardReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([referredId, createdAt])
  @@index([referralId, createdAt])
}

model PlayerProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  displayName    String   @db.VarChar(50)
  avatarUrl      String?  @db.Text
  avatarFrameKey String?  @db.VarChar(80)
  nameEffectKey  String?  @db.VarChar(80)
  countryCode    String?  @db.VarChar(2)
  bio            String?  @db.VarChar(250)
  isPublic       Boolean  @default(true)
  metadata       Json?
  level          Int      @default(1)
  xp             BigInt   @default(0)
  elo            Int      @default(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@index([level])
  @@index([countryCode])
}

model PlayerStorageItem {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid
  key          String                  @db.VarChar(100)
  value        String                  @db.Text
  visibility   PlayerStorageVisibility @default(PRIVATE)
  valueType    PlayerStorageValueType  @default(STRING)
  displayOrder Int                     @default(0)
  version      Int                     @default(1)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, visibility, displayOrder])
  @@index([key, visibility])
}

model StoredFile {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String?              @db.Uuid
  objectKey    String               @unique @db.VarChar(512)
  originalName String               @db.VarChar(255)
  contentType  String               @db.VarChar(120)
  byteSize     BigInt
  checksum     String?              @db.VarChar(128)
  purpose      String               @db.VarChar(80)
  visibility   StoredFileVisibility @default(PRIVATE)
  status       StoredFileStatus     @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, status])
  @@index([purpose, status, createdAt])
}

model FeedbackCategory {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  entity      FeedbackEntity
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  feedback    PlayerFeedback[]

  @@index([entity, active, sortOrder])
}

model PlayerFeedback {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  categoryId  String           @db.Uuid
  entity      FeedbackEntity
  entityId    String?          @db.Uuid
  description String           @db.Text
  status      FeedbackStatus   @default(OPEN)
  metadata    Json?
  adminNote   String?          @db.Text
  resolvedAt  DateTime?
  resolvedBy  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    FeedbackCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entity, status, createdAt])
  @@index([categoryId, createdAt])
}

model PlayerStats {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  gamesPlayed      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentWinStreak Int      @default(0)
  highestWinStreak Int      @default(0)
  highestElo       Int      @default(1000)
  totalScore       BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrencyDefinition {
  id                 String                  @id @default(uuid()) @db.Uuid
  code               String                  @unique @db.VarChar(32)
  name               String                  @db.VarChar(100)
  kind               CurrencyKind
  precision          Int                     @default(0)
  active             Boolean                 @default(true)
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  balances           WalletBalance[]
  tierRewards        ProgressionTierReward[]
  rewardGrants       RewardGrant[]
  transactions       WalletTransaction[]
  catalogPrices      CatalogPrice[]
  catalogRewards     CatalogReward[]
  purchases          Purchase[]
  adRewardClaims     AdRewardClaim[]
  leaderboardRewards LeaderboardReward[]
  gldEconomyState    GldEconomyState?
}

model AssetDefinition {
  id                 String               @id @default(uuid()) @db.Uuid
  key                String               @unique @db.VarChar(100)
  name               String               @db.VarChar(120)
  description        String?              @db.Text
  assetType          AssetType
  ownershipPolicy    AssetOwnershipPolicy @default(STACKABLE)
  imageUrl           String?              @db.Text
  imageAlt           String?              @db.VarChar(160)
  imageUrls          Json?
  active             Boolean              @default(true)
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  variations         AssetVariation[]
  inventoryItems     InventoryItem[]
  catalogItems       CatalogItem[]
  rewards            CatalogReward[]
  entitlements       Entitlement[]
  redeemCodes        AssetRedeemCode[]
  paidRewardRequests PaidRewardRequest[]
  leaderboardRewards LeaderboardReward[]

  @@index([active, assetType])
}

model AssetVariation {
  id                 String              @id @default(uuid()) @db.Uuid
  assetDefinitionId  String              @db.Uuid
  key                String              @db.VarChar(100)
  name               String?             @db.VarChar(120)
  imageUrl           String?             @db.Text
  imageAlt           String?             @db.VarChar(160)
  imageUrls          Json?
  active             Boolean             @default(true)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assetDefinition    AssetDefinition     @relation(fields: [assetDefinitionId], references: [id], onDelete: Cascade)
  inventoryItems     InventoryItem[]
  rewards            CatalogReward[]
  redeemCodes        AssetRedeemCode[]
  paidRewardRequests PaidRewardRequest[]
  leaderboardRewards LeaderboardReward[]

  @@unique([assetDefinitionId, key])
  @@index([assetDefinitionId, active])
}

model Catalog {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique @db.VarChar(80)
  name        String        @db.VarChar(120)
  description String?       @db.Text
  active      Boolean       @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       CatalogItem[]

  @@index([active, startsAt, endsAt])
}

model CatalogItem {
  id                String           @id @default(uuid()) @db.Uuid
  catalogId         String           @db.Uuid
  key               String           @db.VarChar(100)
  name              String           @db.VarChar(120)
  description       String?          @db.Text
  assetDefinitionId String?          @db.Uuid
  imageUrl          String?          @db.Text
  imageAlt          String?          @db.VarChar(160)
  imageUrls         Json?
  purchasable       Boolean          @default(true)
  active            Boolean          @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  catalog           Catalog          @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  assetDefinition   AssetDefinition? @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  prices            CatalogPrice[]
  rewards           CatalogReward[]
  purchaseLines     PurchaseLine[]
  gifts             PlayerGift[]

  @@unique([catalogId, key])
  @@index([catalogId, active, startsAt, endsAt])
  @@index([assetDefinitionId])
}

/// Player-to-player social gifts are intentionally independent from Commerce.
/// A gift is a simple GLD transfer/burn definition, not a store entitlement.
model SocialGiftDefinition {
  id                 String       @id @default(uuid()) @db.Uuid
  key                String       @unique @db.VarChar(80)
  name               String       @db.VarChar(120)
  icon               String?      @db.VarChar(16)
  description        String?      @db.Text
  imageUrl           String?      @db.Text
  priceGld           BigInt
  priceGldDecimal    Decimal      @default(0) @db.Decimal(30, 6)
  recipientRewardBps Int          @default(5000)
  active             Boolean      @default(true)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  gifts              PlayerGift[]

  @@index([active, sortOrder])
}

model CatalogPrice {
  id            String             @id @default(uuid()) @db.Uuid
  catalogItemId String             @db.Uuid
  currencyId    String             @db.Uuid
  amount        BigInt
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  catalogItem   CatalogItem        @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  currency      CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([catalogItemId, currencyId])
  @@index([currencyId, active])
}

model CatalogReward {
  id                      String                 @id @default(uuid()) @db.Uuid
  catalogItemId           String                 @db.Uuid
  rewardType              CatalogRewardType
  assetDefinitionId       String?                @db.Uuid
  assetVariationId        String?                @db.Uuid
  currencyId              String?                @db.Uuid
  progressionDefinitionId String?                @db.Uuid
  targetKey               String?                @db.VarChar(120)
  amount                  BigInt?
  quantity                Int                    @default(1)
  sortOrder               Int                    @default(0)
  metadata                Json?
  createdAt               DateTime               @default(now())
  catalogItem             CatalogItem            @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  assetDefinition         AssetDefinition?       @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  assetVariation          AssetVariation?        @relation(fields: [assetVariationId], references: [id], onDelete: Restrict)
  currency                CurrencyDefinition?    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  progressionDefinition   ProgressionDefinition? @relation(fields: [progressionDefinitionId], references: [id], onDelete: Restrict)

  @@index([catalogItemId, sortOrder])
  @@index([assetDefinitionId])
  @@index([progressionDefinitionId])
}

model InventoryItem {
  id                String                     @id @default(uuid()) @db.Uuid
  instanceId        String                     @unique @default(uuid()) @db.Uuid
  stackKey          String?
  userId            String                     @db.Uuid
  assetDefinitionId String                     @db.Uuid
  assetVariationId  String?                    @db.Uuid
  quantity          Int                        @default(1)
  acquisitionSource InventoryAcquisitionSource
  sourceId          String                     @db.VarChar(255)
  rentalExpiresAt   DateTime?
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetDefinition   AssetDefinition            @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  assetVariation    AssetVariation?            @relation(fields: [assetVariationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, assetDefinitionId, assetVariationId])
  @@index([sourceId])
}

model AssetRedeemCode {
  id                String                @id @default(uuid()) @db.Uuid
  assetDefinitionId String                @db.Uuid
  assetVariationId  String?               @db.Uuid
  code              String                @db.Text
  codeHash          String                @unique @db.Char(64)
  status            AssetRedeemCodeStatus @default(AVAILABLE)
  assignedUserId    String?               @db.Uuid
  assignedAt        DateTime?
  requestId         String?               @unique @db.Uuid
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  assetDefinition   AssetDefinition       @relation(fields: [assetDefinitionId], references: [id], onDelete: Cascade)
  assetVariation    AssetVariation?       @relation(fields: [assetVariationId], references: [id], onDelete: Restrict)
  assignedUser      User?                 @relation("RedeemCodeAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  request           PaidRewardRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([assetDefinitionId, assetVariationId, status, createdAt])
  @@index([assignedUserId, status, createdAt])
}

model PaidRewardRequest {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @db.Uuid
  assetDefinitionId     String                  @db.Uuid
  assetVariationId      String?                 @db.Uuid
  status                PaidRewardRequestStatus @default(PENDING)
  /// GLD amount quoted for this request. It is charged only when fulfilled.
  gldPrice              BigInt?
  /// The GLD USD-micros price locked when the request was created.
  gldUnitPriceUsdMicros BigInt?
  /// USD-micros reserve cost consumed when this request is fulfilled. This is
  /// based on the pre-fee GLD amount, so the charged GLD includes a margin.
  reserveCostUsdMicros  BigInt?
  /// The extra GLD charged above the reserve-cost conversion as the platform fee.
  gldFeeAmount          BigInt?
  /// GLD actually debited at fulfillment. Null means the request was not charged.
  gldChargedAmount      BigInt?
  gldRefundedAmount     BigInt                  @default(0)
  requestKey            String                  @unique @db.VarChar(128)
  message               String?                 @db.VarChar(500)
  adminNote             String?                 @db.VarChar(500)
  inventoryItemId       String?                 @db.Uuid
  idempotencyKeyId      String                  @unique @db.Uuid
  decidedById           String?                 @db.Uuid
  requestedAt           DateTime                @default(now())
  decidedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetDefinition       AssetDefinition         @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)
  assetVariation        AssetVariation?         @relation(fields: [assetVariationId], references: [id], onDelete: Restrict)
  redeemCode            AssetRedeemCode?        @relation
  idempotencyKey        IdempotencyKey          @relation(fields: [idempotencyKeyId], references: [id], onDelete: Restrict)
  decidedBy             User?                   @relation("PaidRewardRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([userId, status, requestedAt])
  @@index([assetDefinitionId, assetVariationId, status])
}

model Purchase {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  status            PurchaseStatus     @default(PENDING)
  currencyId        String             @db.Uuid
  totalAmount       BigInt
  idempotencyKeyId  String             @unique @db.Uuid
  provider          String?            @db.VarChar(40)
  providerReference String?            @unique @db.VarChar(255)
  failureReason     String?            @db.Text
  metadata          Json?
  completedAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency          CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  idempotencyKey    IdempotencyKey     @relation(fields: [idempotencyKeyId], references: [id], onDelete: Restrict)
  lines             PurchaseLine[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PurchaseLine {
  id               String       @id @default(uuid()) @db.Uuid
  purchaseId       String       @db.Uuid
  catalogItemId    String?      @db.Uuid
  itemKeySnapshot  String       @db.VarChar(100)
  itemNameSnapshot String       @db.VarChar(120)
  quantity         Int
  unitAmount       BigInt
  totalAmount      BigInt
  rewardSnapshot   Json
  createdAt        DateTime     @default(now())
  purchase         Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  catalogItem      CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([catalogItemId])
}

model Entitlement {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  entitlementKey    String            @db.VarChar(160)
  assetDefinitionId String?           @db.Uuid
  status            EntitlementStatus @default(ACTIVE)
  sourceType        String            @db.VarChar(40)
  sourceId          String            @db.VarChar(255)
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetDefinition   AssetDefinition?  @relation(fields: [assetDefinitionId], references: [id], onDelete: Restrict)

  @@unique([userId, entitlementKey])
  @@index([userId, status, expiresAt])
  @@index([assetDefinitionId])
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  walletType   WalletType          @default(PLAYER)
  status       WalletStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances     WalletBalance[]
  transactions WalletTransaction[]
}

model WalletBalance {
  id          String             @id @default(uuid()) @db.Uuid
  walletId    String             @db.Uuid
  currencyId  String             @db.Uuid
  amount      BigInt             @default(0)
  exactAmount Decimal            @default(0) @db.Decimal(30, 6)
  version     BigInt             @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency    CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([walletId, currencyId])
  @@index([currencyId])
}

model IdempotencyKey {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String?             @db.Uuid
  scope              String              @db.VarChar(100)
  key                String              @db.VarChar(128)
  requestHash        String              @db.Char(64)
  responseJson       Json?
  status             IdempotencyStatus   @default(PROCESSING)
  createdAt          DateTime            @default(now())
  completedAt        DateTime?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchSettlement    MatchSettlement?
  purchase           Purchase?
  matchmakingTickets MatchmakingTicket[]
  paidRewardRequest  PaidRewardRequest?
  playerGift         PlayerGift?

  @@unique([scope, key])
  @@index([userId, scope])
}

model PlayerGift {
  id                     String                @id @default(uuid()) @db.Uuid
  senderUserId           String                @db.Uuid
  recipientUserId        String                @db.Uuid
  catalogItemId          String?               @db.Uuid
  socialGiftDefinitionId String?               @db.Uuid
  gldPrice               BigInt
  gldPriceDecimal        Decimal               @default(0) @db.Decimal(30, 6)
  giftFeeAmount          BigInt                @default(0)
  chargedAmount          BigInt                @default(0)
  burnedAmount           BigInt
  retainedAmount         BigInt
  burnedAmountDecimal    Decimal               @default(0) @db.Decimal(30, 6)
  retainedAmountDecimal  Decimal               @default(0) @db.Decimal(30, 6)
  recipientAmount        Decimal               @default(0) @db.Decimal(30, 6)
  recipientRewardBps     Int                   @default(0)
  idempotencyKeyId       String                @unique @db.Uuid
  createdAt              DateTime              @default(now())
  sender                 User                  @relation("SentGifts", fields: [senderUserId], references: [id])
  recipient              User                  @relation("ReceivedGifts", fields: [recipientUserId], references: [id])
  catalogItem            CatalogItem?          @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
