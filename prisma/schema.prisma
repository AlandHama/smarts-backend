generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum SessionStatus {
  ACTIVE
  TERMINATED
}

enum CurrencyKind {
  SOFT
  HARD
  PREMIUM
  EVENT
}

enum WalletType {
  PLAYER
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  LOCKED
  CLOSED
}

enum ProgressionKind {
  LEVEL
  RATING
  BATTLE_PASS
  SKILL
  OTHER
}

enum ProgressionResetPolicy {
  NEVER
  SEASON
  MANUAL
}

enum ProgressionRewardType {
  PROGRESSION_POINTS
  PROGRESSION_RESET
  CURRENCY
  ASSET
  ENTITLEMENT
}

enum ProgressionEventSourceType {
  MATCH
  AD
  PURCHASE
  ADMIN
  SYSTEM
}

enum RewardGrantStatus {
  GRANTED
  PENDING
  REJECTED
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
  REVERSAL
}

enum WalletTransactionSourceType {
  SIGNUP
  MATCH
  AD
  PURCHASE
  REFUND
  ADMIN
  SYSTEM
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LeaderboardMemberType {
  PLAYER
  COUNTRY
  GENERIC
}

enum LeaderboardPeriod {
  ALL_TIME
  WEEKLY
  MONTHLY
  SEASONAL
}

enum LeaderboardDirection {
  DESCENDING
  ASCENDING
}

enum LeaderboardWritePolicy {
  SERVER_ONLY
  AUTHENTICATED_COMMAND
}

enum LeaderboardSeasonStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum LeaderboardScoreSourceType {
  MATCH
  ADMIN
  SYSTEM
}

enum GameMode {
  SINGLE_PLAYER
  BOT
  RANKED
  CASUAL
}

enum MatchStatus {
  CREATED
  STARTED
  FINISHED
  REVIEW
  CANCELLED
  SETTLED
}

enum MatchParticipantType {
  PLAYER
  BOT
}

enum MatchParticipantResult {
  PENDING
  WIN
  LOSS
  DRAW
  COMPLETED
  FORFEIT
}

enum MatchEventType {
  READY
  HEARTBEAT
  ANSWER
  SCORE_UPDATE
  FINISH
  LEAVE
  FORFEIT
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  firstName    String?    @db.VarChar(100)
  lastName     String?    @db.VarChar(100)
  email        String?    @unique @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  isSystemAdmin Boolean    @default(false)
  lastOnline   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  profile      PlayerProfile?
  stats        PlayerStats?
  wallet       Wallet?
  progressions      PlayerProgression[]
  idempotencyKeys   IdempotencyKey[]
  progressionEvents ProgressionEvent[]
  rewardGrants      RewardGrant[]
  leaderboardEntries LeaderboardEntry[]
  leaderboardScoreEvents LeaderboardScoreEvent[] @relation("LeaderboardScoreEventPlayer")
  createdMatches Match[] @relation("MatchCreatedBy")
  matchParticipants MatchParticipant[]
  gameStats PlayerGameStats[]
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  tokenId             String        @unique @db.Uuid
  sessionStatus       SessionStatus @default(ACTIVE)
  isMobileSession     Boolean       @default(true)
  clientVersion       String?       @db.VarChar(32)
  deviceInfo          String?       @db.VarChar(500)
  ipAddress           String?       @db.VarChar(100)
  deviceName          String?       @db.VarChar(100)
  location            String?        @db.VarChar(100)
  loginTimestamp      DateTime      @default(now())
  lastActiveTimestamp DateTime      @default(now())
  expiresAt           DateTime
  refreshTokenHash    String        @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenId])
  @@index([userId, sessionStatus])
  @@index([expiresAt])
}

model PlayerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(50)
  avatarUrl   String?  @db.Text
  countryCode String?  @db.VarChar(2)
  bio         String?  @db.VarChar(250)
  level       Int      @default(1)
  xp          BigInt   @default(0)
  elo         Int      @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@index([level])
  @@index([countryCode])
}

model PlayerStats {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  gamesPlayed      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentWinStreak Int      @default(0)
  highestWinStreak Int      @default(0)
  highestElo       Int      @default(1000)
  totalScore       BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrencyDefinition {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(32)
  name      String       @db.VarChar(100)
  kind      CurrencyKind
  precision Int          @default(0)
  active    Boolean      @default(true)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  balances     WalletBalance[]
  tierRewards  ProgressionTierReward[]
  rewardGrants RewardGrant[]
  transactions WalletTransaction[]
}

model Wallet {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @unique @db.Uuid
  walletType WalletType     @default(PLAYER)
  status     WalletStatus   @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances     WalletBalance[]
  transactions WalletTransaction[]
}

model WalletBalance {
  id         String             @id @default(uuid()) @db.Uuid
  walletId   String             @db.Uuid
  currencyId String             @db.Uuid
  amount     BigInt             @default(0)
  version    BigInt             @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  wallet     Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency   CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([walletId, currencyId])
  @@index([currencyId])
}

model IdempotencyKey {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String?          @db.Uuid
  scope        String           @db.VarChar(100)
  key          String           @db.VarChar(128)
  requestHash  String           @db.Char(64)
  responseJson Json?
  status       IdempotencyStatus @default(PROCESSING)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchSettlement MatchSettlement?

  @@unique([scope, key])
  @@index([userId, scope])
}

model ProgressionDefinition {
  id            String                 @id @default(uuid()) @db.Uuid
  key           String                 @unique @db.VarChar(64)
  name          String                 @db.VarChar(100)
  kind          ProgressionKind
  active        Boolean                @default(true)
  allowNegative Boolean                @default(false)
  resetPolicy   ProgressionResetPolicy @default(NEVER)
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tiers         ProgressionTier[]
  playerRows    PlayerProgression[]
  rewards       ProgressionTierReward[] @relation("TargetProgression")
  events        ProgressionEvent[]
  grants        RewardGrant[]
}

model ProgressionTier {
  id              String                  @id @default(uuid()) @db.Uuid
  progressionId   String                  @db.Uuid
  step            Int
  pointsThreshold BigInt
  name            String?                 @db.VarChar(100)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  progression     ProgressionDefinition   @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  rewards         ProgressionTierReward[]

  @@unique([progressionId, step])
  @@unique([progressionId, pointsThreshold])
  @@index([progressionId, pointsThreshold])
}

model ProgressionTierReward {
  id                   String                @id @default(uuid()) @db.Uuid
  tierId               String                @db.Uuid
  rewardType           ProgressionRewardType
  targetProgressionId  String?               @db.Uuid
  currencyId           String?               @db.Uuid
  targetKey            String?               @db.VarChar(120)
  amount               BigInt?
  sortOrder            Int                   @default(0)
  metadata             Json?
  createdAt            DateTime              @default(now())
  tier                 ProgressionTier       @relation(fields: [tierId], references: [id], onDelete: Cascade)
  targetProgression    ProgressionDefinition? @relation("TargetProgression", fields: [targetProgressionId], references: [id], onDelete: Restrict)
  currency             CurrencyDefinition?  @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([tierId, sortOrder])
  @@index([targetProgressionId])
}

model PlayerProgression {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  progressionId      String               @db.Uuid
  points             BigInt               @default(0)
  step               Int                  @default(1)
  previousThreshold  BigInt               @default(0)
  nextThreshold      BigInt?
  lastLevelUpAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progression        ProgressionDefinition @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  events             ProgressionEvent[]

  @@unique([userId, progressionId])
  @@index([progressionId, points])
}

model ProgressionEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @db.Uuid
  progressionId   String                    @db.Uuid
  playerRowId     String                    @db.Uuid
  delta           BigInt
  balanceBefore   BigInt
  balanceAfter    BigInt
  sourceType      ProgressionEventSourceType
  sourceId        String                    @db.VarChar(255)
  idempotencyKeyId String?                  @db.Uuid
  metadata        Json?
  createdAt       DateTime                  @default(now())
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progression     ProgressionDefinition     @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  playerRow       PlayerProgression         @relation(fields: [playerRowId], references: [id], onDelete: Cascade)

  @@index([userId, progressionId, createdAt])
  @@index([sourceType, sourceId])
  @@index([idempotencyKeyId])
}

model RewardGrant {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @db.Uuid
  sourceType            WalletTransactionSourceType
  sourceId              String               @db.VarChar(255)
  rewardType            ProgressionRewardType
  grantKey              String               @unique @db.VarChar(255)
  progressionDefinitionId String?             @db.Uuid
  currencyId            String?              @db.Uuid
  amount                BigInt?
  targetKey             String?              @db.VarChar(120)
  status                RewardGrantStatus   @default(GRANTED)
  policyVersion         String?              @db.VarChar(32)
  idempotencyKeyId      String?              @db.Uuid
  metadata              Json?
  createdAt             DateTime             @default(now())
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressionDefinition ProgressionDefinition? @relation(fields: [progressionDefinitionId], references: [id], onDelete: Restrict)
  currency              CurrencyDefinition? @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model WalletTransaction {
  id              String                    @id @default(uuid()) @db.Uuid
  walletId        String                    @db.Uuid
  currencyId      String                    @db.Uuid
  direction       WalletTransactionDirection
  amount          BigInt
  balanceBefore   BigInt
  balanceAfter    BigInt
  sourceType      WalletTransactionSourceType
  sourceId        String                    @db.VarChar(255)
  grantKey        String?                   @unique @db.VarChar(255)
  idempotencyKeyId String?                  @db.Uuid
  metadata        Json?
  createdAt       DateTime                  @default(now())
  wallet          Wallet                    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency        CurrencyDefinition        @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([walletId, currencyId, createdAt])
  @@index([sourceType, sourceId])
  @@index([idempotencyKeyId])
}

model Leaderboard {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique @db.VarChar(80)
  name        String                   @db.VarChar(120)
  memberType  LeaderboardMemberType
  period      LeaderboardPeriod
  direction   LeaderboardDirection     @default(DESCENDING)
  writePolicy LeaderboardWritePolicy   @default(SERVER_ONLY)
  active      Boolean                  @default(true)
  metadata    Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  seasons     LeaderboardSeason[]
  entries     LeaderboardEntry[]
  scoreEvents LeaderboardScoreEvent[]
}

model LeaderboardSeason {
  id            String                  @id @default(uuid()) @db.Uuid
  leaderboardId String                  @db.Uuid
  startsAt      DateTime
  endsAt        DateTime
  status        LeaderboardSeasonStatus  @default(SCHEDULED)
  resetAt       DateTime?
  createdAt     DateTime                @default(now())
  leaderboard   Leaderboard             @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  entries       LeaderboardEntry[]
  scoreEvents   LeaderboardScoreEvent[]

  @@unique([leaderboardId, startsAt])
  @@index([leaderboardId, status, startsAt, endsAt])
}

model LeaderboardEntry {
  id            String             @id @default(uuid()) @db.Uuid
  leaderboardId String             @db.Uuid
  seasonId      String             @db.Uuid
  playerId      String?            @db.Uuid
  memberKey     String             @db.VarChar(128)
  score         BigInt             @default(0)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  leaderboard   Leaderboard        @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  season        LeaderboardSeason  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player        User?              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scoreEvents   LeaderboardScoreEvent[]

  @@unique([leaderboardId, seasonId, memberKey])
  @@index([leaderboardId, seasonId, score])
  @@index([playerId])
}

model LeaderboardScoreEvent {
  id              String                       @id @default(uuid()) @db.Uuid
  entryId         String?                      @db.Uuid
  leaderboardId   String                       @db.Uuid
  seasonId        String                       @db.Uuid
  memberKey       String                       @db.VarChar(128)
  playerId        String?                      @db.Uuid
  delta           BigInt
  scoreBefore     BigInt
  scoreAfter      BigInt
  sourceType      LeaderboardScoreSourceType
  sourceId        String                       @db.VarChar(255)
  idempotencyKeyId String?                     @db.Uuid
  createdAt       DateTime                     @default(now())
  entry           LeaderboardEntry?            @relation(fields: [entryId], references: [id], onDelete: SetNull)
  leaderboard     Leaderboard                  @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  season          LeaderboardSeason            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player          User?                        @relation("LeaderboardScoreEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([entryId, sourceType, sourceId])
  @@index([entryId, createdAt])
  @@index([sourceType, sourceId])
  @@index([idempotencyKeyId])
}

model GameDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique @db.VarChar(64)
  name        String       @db.VarChar(120)
  active      Boolean      @default(true)
  modePolicy  Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  configs     GameConfig[]
  matches     Match[]
  content     GameContentItem[]
  gameStats   PlayerGameStats[]
}

model GameConfig {
  id                         String         @id @default(uuid()) @db.Uuid
  gameDefinitionId           String         @db.Uuid
  version                    Int            @default(1)
  active                     Boolean        @default(true)
  mainProgressionKey         String         @db.VarChar(64)
  eloProgressionKey          String         @db.VarChar(64)
  rewardCurrencyCode         String         @db.VarChar(32)
  scoreMultiplierForXp       Decimal        @db.Decimal(20, 8)
  maxEloDelta                Int
  soloEloScoreDivisor        Int
  soloEloMaxDelta             Int
  winnerBaseReward            BigInt
  loserBaseReward             BigInt
  drawReward                  BigInt
  scoreRewardDivisor          Int
  scoreRewardCap              BigInt
  winnerRewardBonusMax        BigInt
  loserRewardBonusMax         BigInt
  multiplayerRewardReference  BigInt
  correctAnswerPoints         Json
  wrongAnswerPenaltyPercent   Int
  maxAnswerTimeSeconds        Int
  maxMatchDurationSeconds     Int
  maxQuestions                Int
  rankingEnabled              Boolean        @default(false)
  rankingEloMultiplier        Decimal        @db.Decimal(20, 8)
  rankingLevelMultiplier      Decimal        @db.Decimal(20, 8)
  rankingCoinMultiplier       Decimal        @db.Decimal(20, 8)
  settings                    Json?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  gameDefinition              GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)
  matches                    Match[]

  @@unique([gameDefinitionId, version])
  @@index([gameDefinitionId, active, version])
}

model Match {
  id                String         @id @default(uuid()) @db.Uuid
  gameDefinitionId  String         @db.Uuid
  gameConfigId      String         @db.Uuid
  mode              GameMode
  status            MatchStatus    @default(CREATED)
  serverNonce       String         @unique @db.VarChar(128)
  startedAt         DateTime?
  endedAt           DateTime?
  settledAt         DateTime?
  createdByUserId   String         @db.Uuid
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  gameDefinition    GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Restrict)
  gameConfig        GameConfig     @relation(fields: [gameConfigId], references: [id], onDelete: Restrict)
  createdBy         User           @relation("MatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants      MatchParticipant[]
  events            MatchEvent[]
  settlement        MatchSettlement?
  assignments       MatchContentAssignment[]

  @@index([status, createdAt])
  @@index([createdByUserId, status])
}

model MatchParticipant {
  id                String                  @id @default(uuid()) @db.Uuid
  matchId           String                  @db.Uuid
  userId            String?                 @db.Uuid
  participantType   MatchParticipantType
  finalScore        Int?
  answeredCount     Int                     @default(0)
  result            MatchParticipantResult  @default(PENDING)
  submittedAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  match             Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  events            MatchEvent[]
  assignments       MatchContentAssignment[]
  winnerSettlement  MatchSettlement?        @relation("MatchSettlementWinner")

  @@unique([matchId, userId])
  @@index([matchId, result])
  @@index([userId, createdAt])
}

model MatchEvent {
  id                String         @id @default(uuid()) @db.Uuid
  matchId           String         @db.Uuid
  participantId     String         @db.Uuid
  sequence          Int
  eventType         MatchEventType
  clientEventId     String         @db.VarChar(128)
  payload           Json?
  clientOccurredAt  DateTime?
  serverReceivedAt  DateTime       @default(now())
  accepted          Boolean        @default(false)
  rejectionReason   String?        @db.VarChar(160)
  match             Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant       MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantId, clientEventId])
  @@unique([matchId, participantId, sequence])
  @@index([matchId, participantId, serverReceivedAt])
}

model MatchSettlement {
  id                    String             @id @default(uuid()) @db.Uuid
  matchId               String             @unique @db.Uuid
  policyVersion         String             @db.VarChar(32)
  winnerParticipantId   String?            @unique @db.Uuid
  settlementJson        Json
  idempotencyKeyId      String             @unique @db.Uuid
  createdAt             DateTime           @default(now())
  match                 Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerParticipant     MatchParticipant?  @relation("MatchSettlementWinner", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  idempotencyKey        IdempotencyKey     @relation(fields: [idempotencyKeyId], references: [id], onDelete: Restrict)
}

model GameContentItem {
  id              String          @id @default(uuid()) @db.Uuid
  gameDefinitionId String         @db.Uuid
  version         Int             @default(1)
  contentType     String          @db.VarChar(40)
  prompt          Json
  options         Json
  difficulty      Int             @default(1)
  category        String?         @db.VarChar(80)
  answerHash      String          @db.Char(64)
  answerIndex     Int
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  gameDefinition  GameDefinition  @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)
  assignments     MatchContentAssignment[]

  @@index([gameDefinitionId, active, version])
}

model MatchContentAssignment {
  id              String          @id @default(uuid()) @db.Uuid
  matchId         String          @db.Uuid
  participantId   String          @db.Uuid
  contentItemId   String          @db.Uuid
  position        Int
  assignmentTokenHash String      @db.Char(64)
  servedAt        DateTime        @default(now())
  expiresAt       DateTime?
  answeredAt      DateTime?
  createdAt       DateTime        @default(now())
  match           Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant     MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contentItem     GameContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Restrict)

  @@unique([matchId, participantId, position])
  @@index([participantId, contentItemId])
  @@index([matchId, participantId, answeredAt])
}

model PlayerGameStats {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  gameDefinitionId String        @db.Uuid
  gamesPlayed     Int            @default(0)
  wins            Int            @default(0)
  losses          Int            @default(0)
  draws           Int            @default(0)
  forfeits        Int            @default(0)
  totalCorrect    Int            @default(0)
  totalQuestions  Int            @default(0)
  totalTimeMs     BigInt         @default(0)
  totalScore      BigInt         @default(0)
  bestScore       BigInt         @default(0)
  lastPlayedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDefinition  GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, gameDefinitionId])
  @@index([gameDefinitionId, totalScore])
}

model OutboxEvent {
  id            String           @id @default(uuid()) @db.Uuid
  eventType     String           @db.VarChar(120)
  aggregateType String           @db.VarChar(80)
  aggregateId   String           @db.Uuid
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now())
  processedAt   DateTime?
  lastError     String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}
