generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum SessionStatus {
  ACTIVE
  TERMINATED
}

enum CurrencyKind {
  SOFT
  HARD
  PREMIUM
  EVENT
}

enum WalletType {
  PLAYER
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  LOCKED
  CLOSED
}

enum ProgressionKind {
  LEVEL
  RATING
  BATTLE_PASS
  SKILL
  OTHER
}

enum ProgressionResetPolicy {
  NEVER
  SEASON
  MANUAL
}

enum ProgressionRewardType {
  PROGRESSION_POINTS
  PROGRESSION_RESET
  CURRENCY
  ASSET
  ENTITLEMENT
}

enum ProgressionEventSourceType {
  MATCH
  AD
  PURCHASE
  ADMIN
  SYSTEM
}

enum RewardGrantStatus {
  GRANTED
  PENDING
  REJECTED
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
  REVERSAL
}

enum WalletTransactionSourceType {
  SIGNUP
  MATCH
  AD
  PURCHASE
  REFUND
  ADMIN
  SYSTEM
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  firstName    String?    @db.VarChar(100)
  lastName     String?    @db.VarChar(100)
  email        String?    @unique @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  isSystemAdmin Boolean    @default(false)
  lastOnline   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  profile      PlayerProfile?
  stats        PlayerStats?
  wallet       Wallet?
  progressions      PlayerProgression[]
  idempotencyKeys   IdempotencyKey[]
  progressionEvents ProgressionEvent[]
  rewardGrants      RewardGrant[]
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  tokenId             String        @unique @db.Uuid
  sessionStatus       SessionStatus @default(ACTIVE)
  isMobileSession     Boolean       @default(true)
  clientVersion       String?       @db.VarChar(32)
  deviceInfo          String?       @db.VarChar(500)
  ipAddress           String?       @db.VarChar(100)
  deviceName          String?       @db.VarChar(100)
  location            String?        @db.VarChar(100)
  loginTimestamp      DateTime      @default(now())
  lastActiveTimestamp DateTime      @default(now())
  expiresAt           DateTime
  refreshTokenHash    String        @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenId])
  @@index([userId, sessionStatus])
  @@index([expiresAt])
}

model PlayerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(50)
  avatarUrl   String?  @db.Text
  countryCode String?  @db.VarChar(2)
  bio         String?  @db.VarChar(250)
  level       Int      @default(1)
  xp          BigInt   @default(0)
  elo         Int      @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@index([level])
  @@index([countryCode])
}

model PlayerStats {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  gamesPlayed      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentWinStreak Int      @default(0)
  highestWinStreak Int      @default(0)
  highestElo       Int      @default(1000)
  totalScore       BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrencyDefinition {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(32)
  name      String       @db.VarChar(100)
  kind      CurrencyKind
  precision Int          @default(0)
  active    Boolean      @default(true)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  balances     WalletBalance[]
  tierRewards  ProgressionTierReward[]
  rewardGrants RewardGrant[]
  transactions WalletTransaction[]
}

model Wallet {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @unique @db.Uuid
  walletType WalletType     @default(PLAYER)
  status     WalletStatus   @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances     WalletBalance[]
  transactions WalletTransaction[]
}

model WalletBalance {
  id         String             @id @default(uuid()) @db.Uuid
  walletId   String             @db.Uuid
  currencyId String             @db.Uuid
  amount     BigInt             @default(0)
  version    BigInt             @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  wallet     Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency   CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([walletId, currencyId])
  @@index([currencyId])
}

model IdempotencyKey {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String?          @db.Uuid
  scope        String           @db.VarChar(100)
  key          String           @db.VarChar(128)
  requestHash  String           @db.Char(64)
  responseJson Json?
  status       IdempotencyStatus @default(PROCESSING)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([userId, scope])
}

model ProgressionDefinition {
  id            String                 @id @default(uuid()) @db.Uuid
  key           String                 @unique @db.VarChar(64)
  name          String                 @db.VarChar(100)
  kind          ProgressionKind
  active        Boolean                @default(true)
  allowNegative Boolean                @default(false)
  resetPolicy   ProgressionResetPolicy @default(NEVER)
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tiers         ProgressionTier[]
  playerRows    PlayerProgression[]
  rewards       ProgressionTierReward[] @relation("TargetProgression")
  events        ProgressionEvent[]
  grants        RewardGrant[]
}

model ProgressionTier {
  id              String                  @id @default(uuid()) @db.Uuid
  progressionId   String                  @db.Uuid
  step            Int
  pointsThreshold BigInt
  name            String?                 @db.VarChar(100)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  progression     ProgressionDefinition   @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  rewards         ProgressionTierReward[]

  @@unique([progressionId, step])
  @@unique([progressionId, pointsThreshold])
  @@index([progressionId, pointsThreshold])
}

model ProgressionTierReward {
  id                   String                @id @default(uuid()) @db.Uuid
  tierId               String                @db.Uuid
  rewardType           ProgressionRewardType
  targetProgressionId  String?               @db.Uuid
  currencyId           String?               @db.Uuid
  targetKey            String?               @db.VarChar(120)
  amount               BigInt?
  sortOrder            Int                   @default(0)
  metadata             Json?
  createdAt            DateTime              @default(now())
  tier                 ProgressionTier       @relation(fields: [tierId], references: [id], onDelete: Cascade)
  targetProgression    ProgressionDefinition? @relation("TargetProgression", fields: [targetProgressionId], references: [id], onDelete: Restrict)
  currency             CurrencyDefinition?  @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([tierId, sortOrder])
  @@index([targetProgressionId])
}

model PlayerProgression {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  progressionId      String               @db.Uuid
  points             BigInt               @default(0)
  step               Int                  @default(1)
  previousThreshold  BigInt               @default(0)
  nextThreshold      BigInt?
  lastLevelUpAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progression        ProgressionDefinition @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  events             ProgressionEvent[]

  @@unique([userId, progressionId])
  @@index([progressionId, points])
}

model ProgressionEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @db.Uuid
  progressionId   String                    @db.Uuid
  playerRowId     String                    @db.Uuid
  delta           BigInt
  balanceBefore   BigInt
  balanceAfter    BigInt
  sourceType      ProgressionEventSourceType
  sourceId        String                    @db.VarChar(255)
  idempotencyKeyId String?                  @db.Uuid
  metadata        Json?
  createdAt       DateTime                  @default(now())
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progression     ProgressionDefinition     @relation(fields: [progressionId], references: [id], onDelete: Cascade)
  playerRow       PlayerProgression         @relation(fields: [playerRowId], references: [id], onDelete: Cascade)

  @@index([userId, progressionId, createdAt])
  @@index([sourceType, sourceId])
  @@index([idempotencyKeyId])
}

model RewardGrant {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @db.Uuid
  sourceType            WalletTransactionSourceType
  sourceId              String               @db.VarChar(255)
  rewardType            ProgressionRewardType
  grantKey              String               @unique @db.VarChar(255)
  progressionDefinitionId String?             @db.Uuid
  currencyId            String?              @db.Uuid
  amount                BigInt?
  targetKey             String?              @db.VarChar(120)
  status                RewardGrantStatus   @default(GRANTED)
  policyVersion         String?              @db.VarChar(32)
  idempotencyKeyId      String?              @db.Uuid
  metadata              Json?
  createdAt             DateTime             @default(now())
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressionDefinition ProgressionDefinition? @relation(fields: [progressionDefinitionId], references: [id], onDelete: Restrict)
  currency              CurrencyDefinition? @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model WalletTransaction {
  id              String                    @id @default(uuid()) @db.Uuid
  walletId        String                    @db.Uuid
  currencyId      String                    @db.Uuid
  direction       WalletTransactionDirection
  amount          BigInt
  balanceBefore   BigInt
  balanceAfter    BigInt
  sourceType      WalletTransactionSourceType
  sourceId        String                    @db.VarChar(255)
  grantKey        String?                   @unique @db.VarChar(255)
  idempotencyKeyId String?                  @db.Uuid
  metadata        Json?
  createdAt       DateTime                  @default(now())
  wallet          Wallet                    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency        CurrencyDefinition        @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([walletId, currencyId, createdAt])
  @@index([sourceType, sourceId])
  @@index([idempotencyKeyId])
}
