  assignedTickets      SupportTicket[]    @relation("SupportTicketAssignee")
  assignments          SupportTicketAssignment[]

  @@index([status, level])
}

model SupportTicket {
  id                 String                 @id @default(uuid()) @db.Uuid
  ticketNumber       String                 @unique @db.VarChar(30)
  playerId           String                 @db.Uuid
  categoryId         String                 @db.Uuid
  assignedAgentId    String?                @db.Uuid
  subject            String                 @db.VarChar(160)
  status             SupportTicketStatus    @default(OPEN)
  priority           SupportTicketPriority  @default(NORMAL)
  lastSequence       Int                    @default(0)
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  lastPlayerActivity DateTime              @default(now())
  lastAgentActivity  DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  player             User                   @relation("SupportTicketPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  category           SupportCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedAgent      SupportAgent?          @relation("SupportTicketAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages           SupportTicketMessage[]
  events             SupportTicketEvent[]
  assignments        SupportTicketAssignment[]
  reads              SupportTicketRead[]
  auditEvents        SupportAuditEvent[]

  @@index([playerId, status, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([assignedAgentId, status, updatedAt])
  @@index([categoryId, status])
}

model SupportTicketMessage {
  id             String                   @id @default(uuid()) @db.Uuid
  ticketId       String                   @db.Uuid
  senderId       String?                  @db.Uuid
  senderKind     SupportMessageSenderKind
  sequence       Int
  clientMessageId String?                 @db.VarChar(120)
  body           String                   @db.Text
  internal       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  ticket         SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User?                    @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([ticketId, sequence])
  @@unique([ticketId, clientMessageId])
  @@index([ticketId, createdAt])
}

model SupportTicketAssignment {
  id         String       @id @default(uuid()) @db.Uuid
  ticketId   String       @db.Uuid
  agentId    String       @db.Uuid
  assignedById String?    @db.Uuid
  assignedAt DateTime     @default(now())
  unassignedAt DateTime?
  reason     String?      @db.VarChar(500)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent      SupportAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, unassignedAt, assignedAt])
  @@index([ticketId, assignedAt])
}

model SupportTicketEvent {
  id         String              @id @default(uuid()) @db.Uuid
  ticketId   String              @db.Uuid
  actorId    String?             @db.Uuid
  fromStatus SupportTicketStatus?
  toStatus   SupportTicketStatus?
  action     String              @db.VarChar(80)
  note       String?             @db.VarChar(1000)
  createdAt  DateTime            @default(now())
  ticket     SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User?               @relation("SupportTicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SupportTicketRead {
  id           String        @id @default(uuid()) @db.Uuid
  ticketId     String        @db.Uuid
  userId       String        @db.Uuid
  lastSequence Int           @default(0)
  updatedAt    DateTime      @updatedAt
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
}

model SupportAuditEvent {
  id         String        @id @default(uuid()) @db.Uuid
  actorId    String?       @db.Uuid
  ticketId   String?       @db.Uuid
  action     String        @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime      @default(now())
  actor      User?         @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Immutable record of a privileged operation performed from the system console.
/// Passwords, token hashes, and provider secrets must never be written here.
model AdminAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(255)
  reason     String   @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Append-only, server-owned history of actions and state changes for one player.
/// Do not write passwords, token hashes, provider secrets, or sensitive answers.
model PlayerAuditEvent {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  actorType  PlayerAuditActorType @default(SYSTEM)
  action     String               @db.VarChar(120)
  entityType String               @db.VarChar(80)
  entityId   String?              @db.VarChar(255)
  summary    String               @db.VarChar(500)
  changes    Json?
  metadata   Json?
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@index([entityType, createdAt])
  @@index([action, createdAt])
}
