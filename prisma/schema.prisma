generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum SessionStatus {
  ACTIVE
  TERMINATED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  firstName    String?    @db.VarChar(100)
  lastName     String?    @db.VarChar(100)
  email        String?    @unique @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  firebaseUid  String?    @unique @db.VarChar(255)
  lootLockerPlayerId String? @unique @db.VarChar(255)
  lastOnline   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  profile      PlayerProfile?
  stats        PlayerStats?
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  tokenId             String        @unique @db.Uuid
  sessionStatus       SessionStatus @default(ACTIVE)
  isMobileSession     Boolean       @default(true)
  clientVersion       String?       @db.VarChar(32)
  deviceInfo          String?       @db.VarChar(500)
  ipAddress           String?       @db.VarChar(100)
  deviceName          String?       @db.VarChar(100)
  location            String?        @db.VarChar(100)
  loginTimestamp      DateTime      @default(now())
  lastActiveTimestamp DateTime      @default(now())
  expiresAt           DateTime
  refreshTokenHash    String        @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenId])
  @@index([userId, sessionStatus])
  @@index([expiresAt])
}

model PlayerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(50)
  avatarUrl   String?  @db.Text
  countryCode String?  @db.VarChar(2)
  bio         String?  @db.VarChar(250)
  level       Int      @default(1)
  xp          BigInt   @default(0)
  elo         Int      @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@index([level])
  @@index([countryCode])
}

model PlayerStats {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  gamesPlayed      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentWinStreak Int      @default(0)
  highestWinStreak Int      @default(0)
  highestElo       Int      @default(1000)
  totalScore       BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
