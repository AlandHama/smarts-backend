  winnerParticipant   MatchParticipant? @relation("MatchSettlementWinner", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  idempotencyKey      IdempotencyKey    @relation(fields: [idempotencyKeyId], references: [id], onDelete: Restrict)
}

model GameContentItem {
  id               String                   @id @default(uuid()) @db.Uuid
  gameDefinitionId String                   @db.Uuid
  version          Int                      @default(1)
  contentType      String                   @db.VarChar(40)
  sourceKey        String?                  @db.VarChar(160)
  prompt           Json
  options          Json
  difficulty       Int                      @default(1)
  category         String?                  @db.VarChar(80)
  answerHash       String                   @db.Char(64)
  answerIndex      Int
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  gameDefinition   GameDefinition           @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)
  assignments      MatchContentAssignment[]

  @@index([gameDefinitionId, active, version])
}

model MatchContentAssignment {
  id                  String           @id @default(uuid()) @db.Uuid
  matchId             String           @db.Uuid
  participantId       String           @db.Uuid
  roundId             String?          @db.Uuid
  contentItemId       String           @db.Uuid
  position            Int
  assignmentTokenHash String           @db.Char(64)
  servedAt            DateTime         @default(now())
  expiresAt           DateTime?
  answeredAt          DateTime?
  createdAt           DateTime         @default(now())
  match               Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant         MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contentItem         GameContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  round               MatchRound?      @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([matchId, participantId, position])
  @@index([participantId, contentItemId])
  @@index([matchId, participantId, answeredAt])
  @@index([roundId, participantId, position])
}

model PlayerGameStats {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  gameDefinitionId String         @db.Uuid
  gamesPlayed      Int            @default(0)
  wins             Int            @default(0)
  losses           Int            @default(0)
  draws            Int            @default(0)
  forfeits         Int            @default(0)
  totalCorrect     Int            @default(0)
  totalQuestions   Int            @default(0)
  totalTimeMs      BigInt         @default(0)
  totalScore       BigInt         @default(0)
  bestScore        BigInt         @default(0)
  lastPlayedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDefinition   GameDefinition @relation(fields: [gameDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, gameDefinitionId])
  @@index([gameDefinitionId, totalScore])
}

model PlayerCognitiveStats {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  calculation      Int      @default(50)
  speed            Int      @default(50)
  accuracy         Int      @default(50)
  judgement        Int      @default(50)
  observation      Int      @default(50)
  memory           Int      @default(50)
  matchesEvaluated Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accuracy])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @db.VarChar(120)
  aggregateType String            @db.VarChar(80)
  aggregateId   String            @db.Uuid
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  processedAt   DateTime?
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

/// Current, explainable risk state for a player. The score is always derived
/// from FraudSignal rows and is never the sole source of evidence.
model FraudProfile {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @db.Uuid
  score           Int                @default(0)
  riskLevel       FraudRiskLevel     @default(NORMAL)
  status          FraudProfileStatus @default(CLEAR)
  lastEvaluatedAt DateTime?
  lastSignalAt    DateTime?
  reviewedAt      DateTime?
  reviewedById    String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("FraudProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([riskLevel, status, score])
  @@index([lastSignalAt])
}

/// Admin-tunable deterministic detection rule. Rules are data so thresholds
/// and score weights can be adjusted without shipping the mobile app.
model FraudRule {
  id            String        @id @default(uuid()) @db.Uuid
  key           String        @unique @db.VarChar(80)
  name          String        @db.VarChar(120)
  description   String        @db.VarChar(500)
  enabled       Boolean       @default(true)
  scoreDelta    Int           @default(10)
  threshold     Int?
  windowSeconds Int?
  decayDays     Int           @default(30)
  autoOpenScore Int?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  signals       FraudSignal[]

  @@index([enabled, key])
}

/// One explainable observation emitted by an authoritative backend event.
model FraudSignal {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  ruleId     String?           @db.Uuid
  type       String            @db.VarChar(80)
  severity   FraudRiskLevel    @default(LOW)
  scoreDelta Int               @default(0)
  sourceType String            @db.VarChar(80)
  sourceId   String?           @db.VarChar(255)
  dedupeKey  String            @unique @db.VarChar(255)
  metadata   Json?
  status     FraudSignalStatus @default(ACTIVE)
  occurredAt DateTime          @default(now())
  expiresAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule       FraudRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, status, occurredAt])
  @@index([type, occurredAt])
  @@index([sourceType, sourceId])
}

model FraudCase {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  status          FraudCaseStatus @default(OPEN)
  scoreAtOpen     Int
  reason          String          @db.VarChar(500)
  assignedAdminId String?         @db.Uuid
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  resolution      String?         @db.VarChar(500)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation("FraudCasesForUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin   User?           @relation("FraudCaseAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  actions         FraudAction[]

  @@index([status, openedAt])
  @@index([userId, status])
  @@index([assignedAdminId, status])
}

model FraudAction {
  id        String          @id @default(uuid()) @db.Uuid
  caseId    String?         @db.Uuid
  userId    String          @db.Uuid
  actorId   String          @db.Uuid
  action    FraudActionType
  reason    String          @db.VarChar(500)
  metadata  Json?
  createdAt DateTime        @default(now())
  fraudCase FraudCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user      User            @relation("FraudActionsForUser", fields: [userId], references: [id], onDelete: Cascade)
  actor     User            @relation("FraudActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([caseId, createdAt])
}

/// Versioned configuration. `privateConfig` is never returned by a public
/// endpoint and may contain server-only reward/verification policy.
model RewardPolicyVersion {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @db.VarChar(80)
  version       Int
  active        Boolean  @default(true)
  publicConfig  Json
  privateConfig Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, version])
  @@index([key, active, version])
}

model AdRewardClaim {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  provider            String              @db.VarChar(40)
  adFormat            String              @db.VarChar(40)
  claimTokenHash      String              @unique @db.Char(64)
  providerEventId     String?             @db.VarChar(255)
  countryCode         String?             @db.Char(2)
  currencyId          String?             @db.Uuid
  rewardAmount        BigInt?
  rewardAmountDecimal Decimal?            @db.Decimal(30, 6)
  status              AdRewardClaimStatus @default(PENDING)
  verificationPayload Json?
  rejectionReason     String?             @db.VarChar(255)
  expiresAt           DateTime
  verifiedAt          DateTime?
  grantedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency            CurrencyDefinition? @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  referralReward      ReferralReward?

  @@unique([provider, providerEventId])
  @@index([userId, status, createdAt])
  @@index([userId, grantedAt])
  @@index([expiresAt, status])
}

/// Global policy/state for the server-owned GLD economy.
model GldEconomyState {
  id                       String             @id @default(uuid()) @db.Uuid
  currencyId               String             @unique @db.Uuid
  displayedValueUsdMicros  BigInt
  targetValueUsdMicros     BigInt
  treasuryReserveUsdMicros BigInt
  circulatingSupply        BigInt
  reserveRatioBps          Int
  smoothingFactorBps       Int
  minPriceUsdMicros        BigInt?
  maxPriceUsdMicros        BigInt?
  dailyEmissionBudget      BigInt
  dailyEmissionUsed        BigInt
  lastRevenueSnapshotAt    DateTime?
  lastRecalculatedAt       DateTime?
  health                   GldEconomyHealth   @default(CRITICAL)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  currency                 CurrencyDefinition @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([health])
  @@index([lastRecalculatedAt])
}

/// Persisted emergency switches for the server-owned GLD economy.
model GldAdminControl {
  id                          String   @id @default(uuid()) @db.Uuid
  singletonKey                String   @unique @default("default") @db.VarChar(32)
  emissionsPaused             Boolean  @default(false)
  catalogSinksPaused          Boolean  @default(false)
  giftsPaused                 Boolean  @default(false)
  paidRewardsPaused           Boolean  @default(false)
  gldTransferFeeBps           Int      @default(0)
  adDailyGldCap               BigInt?
  adMaxValidatedAds           Int?
  adMaxRewardPerClaim         BigInt?
  admobReserveAllocationBps   Int?
  giftBurnBps                 Int?
  paidRewardSafetyMarginBps   Int?
  paidRewardDailyRequestLimit Int?
  reason                      String?  @db.VarChar(500)
  updatedById                 String?  @db.Uuid
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  updatedBy                   User?    @relation("GldControlUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Server-owned GLD reward for a client-reported ad event. Region codes are
/// ISO country codes when available, with DEFAULT as the fallback.
model GldAdRewardPolicy {
  id                  String   @id @default(uuid()) @db.Uuid
  adFormat            String   @db.VarChar(40)
  eventType           String   @db.VarChar(20)
  regionCode          String   @default("DEFAULT") @db.VarChar(16)
  rewardAmount        BigInt
  /// Exact configured amount for admin display and future fractional GLD support.
  /// Wallet settlement remains whole-unit until the GLD currency precision is migrated.
  rewardAmountDecimal Decimal? @db.Decimal(20, 6)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([adFormat, eventType, regionCode])
  @@index([adFormat, eventType, enabled])
  @@index([regionCode, enabled])
}

/// Immutable revenue input used to fund GLD emission and reserve capacity.
model GldRevenueSnapshot {
  id                        String                      @id @default(uuid()) @db.Uuid
  periodStart               DateTime
  periodEnd                 DateTime
  grossAdRevenueUsdMicros   BigInt
  adCostsUsdMicros          BigInt
  eligibleProfitUsdMicros   BigInt
  playerRewardAllocationBps Int
  reserveAllocationBps      Int
  companyAllocationBps      Int
  rewardBackingUsdMicros    BigInt
  reserveAddedUsdMicros     BigInt
  companyShareUsdMicros     BigInt
  source                    String                      @db.VarChar(80)
  sourceReference           String?                     @db.VarChar(255)
  recognitionStatus         GldRevenueRecognitionStatus @default(PENDING)
  recognitionHaircutBps     Int                         @default(8000)
  metadata                  Json?
  createdById               String?                     @db.Uuid
  createdAt                 DateTime                    @default(now())
  treasuryEntries           GldTreasuryEntry[]

  @@unique([source, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([recognitionStatus, periodEnd])
}

/// Immutable historical economy points for charts and audit.
model GldEconomySnapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  displayedValueUsdMicros  BigInt
  targetValueUsdMicros     BigInt
  treasuryReserveUsdMicros BigInt
  circulatingSupply        BigInt
  reserveRatioBps          Int
  dailyEmissionBudget      BigInt
  dailyEmissionUsed        BigInt
  reason                   String   @db.VarChar(120)
  metadata                 Json?
  createdAt                DateTime @default(now())

  @@index([createdAt])
}

/// Per-UTC-day budget and accounting for all GLD issuance and burns.
model GldEmissionDay {
  id                    String   @id @default(uuid()) @db.Uuid
  dateKey               String   @unique @db.Char(10)
  emissionBudget        BigInt
  emittedAmount         BigInt   @default(0)
  burnedAmount          BigInt   @default(0)
  adRewardAmount        BigInt   @default(0)
  emittedAmountDecimal  Decimal  @default(0) @db.Decimal(30, 6)
  adRewardAmountDecimal Decimal  @default(0) @db.Decimal(30, 6)
  gameplayRewardAmount  BigInt   @default(0)
  promotionalAmount     BigInt   @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Explicit destruction of GLD through an approved economy sink.
model GldBurnEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  amount        BigInt
  exactAmount   Decimal  @default(0) @db.Decimal(30, 6)
  sourceType    String   @db.VarChar(60)
  sourceId      String?  @db.VarChar(255)
  reason        String   @db.VarChar(255)
  ledgerEntryId String?  @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

/// Per-player daily controls for validated rewarded-ad issuance.
model GldPlayerDailyAdState {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  dateKey              String    @db.Char(10)
  validatedAds         Int       @default(0)
  rewardedAds          Int       @default(0)
  gldEarned            BigInt    @default(0)
  gldEarnedDecimal     Decimal   @default(0) @db.Decimal(30, 6)
  rewardValueUsdMicros BigInt    @default(0)
  lastRewardedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
}

/// Double-entry-adjacent audit record for treasury allocations. COST entries
/// are negative because they consume reserve backing for fulfilled rewards.
model GldTreasuryEntry {
  id                String               @id @default(uuid()) @db.Uuid
  revenueSnapshotId String?              @db.Uuid
  manualBackingId   String?              @unique @db.Uuid
  entryType         GldTreasuryEntryType
  amountUsdMicros   BigInt
  currencyCode      String               @default("USD") @db.Char(3)
  idempotencyKey    String               @unique @db.VarChar(160)
  metadata          Json?
  createdAt         DateTime             @default(now())
  revenueSnapshot   GldRevenueSnapshot?  @relation(fields: [revenueSnapshotId], references: [id], onDelete: Restrict)
  manualBacking     GldManualBacking?    @relation(fields: [manualBackingId], references: [id], onDelete: Restrict)

  @@index([revenueSnapshotId, entryType])
  @@index([createdAt])
}

/// Administrator-supplied reserve backing, kept separate from AdMob revenue.
model GldManualBacking {
  id              String            @id @default(uuid()) @db.Uuid
  amountUsdMicros BigInt
  reason          String            @db.VarChar(500)
  idempotencyKey  String            @unique @db.VarChar(160)
  createdById     String            @db.Uuid
  createdAt       DateTime          @default(now())
  createdBy       User              @relation("GldManualBackingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  treasuryEntry   GldTreasuryEntry?

  @@index([createdAt])
  @@index([createdById, createdAt])
}

/// One tenant-wide AdMob OAuth connection. The refresh token is encrypted at
/// rest and is never returned by an API response.
model AdMobConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  provider              String                @unique @default("ADMOB") @db.VarChar(40)
  publisherId           String                @unique @db.VarChar(80)
  googleAccountEmail    String?               @db.VarChar(255)
  reportingTimezone     String?               @db.VarChar(80)
  currencyCode          String?               @db.Char(3)
  encryptedRefreshToken String                @db.Text
  status                AdMobConnectionStatus @default(CONNECTED)
  connectedAt           DateTime              @default(now())
  lastSyncStartedAt     DateTime?
  lastSyncAt            DateTime?
  lastSyncError         String?               @db.Text
  createdById           String?               @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reportRows            AdMobReportRow[]

  @@index([status])
  @@index([lastSyncAt])
}

/// Normalized rows returned by the AdMob network report. Rows are replaced for
/// the synchronized date window because AdMob can revise recent figures.
model AdMobReportRow {
  id                      String          @id @default(uuid()) @db.Uuid
  connectionId            String          @db.Uuid
  reportDate              DateTime        @db.Date
  dimensionKey            String          @db.VarChar(1000)
  appId                   String?         @db.VarChar(160)
  appName                 String?         @db.VarChar(255)
  platform                String?         @db.VarChar(40)
  countryCode             String?         @db.Char(2)
  format                  String?         @db.VarChar(80)
  adUnitId                String?         @db.VarChar(160)
  adUnitName              String?         @db.VarChar(255)
  adRequests              BigInt          @default(0)
  matchedRequests         BigInt          @default(0)
  impressions             BigInt          @default(0)
  clicks                  BigInt          @default(0)
  estimatedEarningsMicros BigInt          @default(0)
  impressionCtrBps        Int             @default(0)
  impressionRpmMicros     BigInt          @default(0)
  matchRateBps            Int             @default(0)
  showRateBps             Int             @default(0)
  raw                     Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  connection              AdMobConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, reportDate, dimensionKey])
  @@index([connectionId, reportDate])
  @@index([reportDate])
  @@index([appId, reportDate])
  @@index([adUnitId, reportDate])
  @@index([countryCode, reportDate])
}

model Notification {
  id                String                 @id @default(uuid()) @db.Uuid
  dedupeKey         String?                @unique @db.VarChar(255)
  userId            String?                @db.Uuid
  outboxEventId     String?                @db.Uuid
  broadcastId       String?                @db.Uuid
  notificationType  String                 @db.VarChar(120)
  title             String                 @db.VarChar(160)
  body              String                 @db.Text
  data              Json?
  status            NotificationStatus     @default(PENDING)
  pushStatus        NotificationPushStatus @default(SKIPPED)
